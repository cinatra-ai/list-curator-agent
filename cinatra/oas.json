    "propose": {
      "component_type": "ApiNode",
      "id": "propose",
      "name": "Propose the scrape schema",
      "url": "{{CINATRA_BASE_URL}}/api/llm-bridge",
      "http_method": "POST",
      "data": {
        "agent_id": "list-curator-agent",
        "system": "You are a list-curator planner. Follow the SKILL.md planning steps ONLY. Resolve seedUrls from the intent when the caller supplied none, and propose the scrape outputSchema for the member kind asked for. Do NOT dispatch any child agent and do NOT write anything to the CRM. Return a single JSON object with {seedUrls, outputSchema, plan} - nothing else.",
        "user": "Plan the curation for this intent.\nInputs:\n- intent: {{ intent }}\n- seedUrls: {{ seedUrls }}\n- targetMemberType: {{ targetMemberType }}  (must be 'contact' or 'account')\n- listName: {{ listName }}",
        "agent_run_id": "{{ agent_run_id }}",
        "cinatra_llm": {
          "preferredProvider": "openai",
          "preferredModel": "gpt-5.5"
        }
      },
      "inputs": [
        {
          "title": "intent",
          "type": "string"
        },
        {
          "title": "seedUrls",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "title": "targetMemberType",
          "type": "string",
          "json_schema": {
            "enum": [
              "contact",
              "account"
            ]
          }
        },
        {
          "title": "listName",
          "type": "string"
        },
        {
          "title": "agent_run_id",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "title": "seedUrls",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "title": "outputSchema",
          "type": "object",
          "description": "The JSON Schema the scrape runs are held to. Intentionally free-form: this is a raw JSON Schema document the person edits as text at the schema_gate review, so its members are chosen per curation run and this agent declares no fixed shape for them."
        },
        {
          "title": "plan",
          "type": "string"
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": false,
          "packageName": "@cinatra-ai/list-curator-agent",
          "description": "The planning half of the retired single step: it proposes, it never writes. The person approves the proposal at schema_gate before anything is collected."
        }
      }
    },
    "schema_gate": {
      "component_type": "InputMessageNode",
      "id": "schema_gate",
      "name": "Review the scrape schema",
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/list-curator-agent:scrape-schema-review",
          "a2uiSurfaceId": "list-curator:schema-review:input",
          "autoSkipWhenInputsPresent": false,
          "description": "Review the seeds and the scrape schema this curation will use, then approve, send them back for revision, or reject the run.",
          "inputMessageSchema": {
            "type": "object",
            "x-renderer": "@cinatra-ai/list-curator-agent:scrape-schema-review",
            "properties": {
              "outputSchema": {
                "type": "object",
                "title": "Scrape schema",
                "readOnly": true
              },
              "seedUrls": {
                "type": "array",
                "title": "Seed pages",
                "items": {
                  "type": "string"
                },
                "readOnly": true
              },
              "plan": {
                "type": "string",
                "title": "Plan",
                "readOnly": true
              },
              "decision": {
                "type": "string",
                "title": "Decision",
                "enum": [
                  "approve",
                  "revise",
                  "reject"
                ],
                "description": "Approve this step, send it back for revision, or reject the run."
              },
              "note": {
                "type": "string",
                "title": "Note"
              }
            },
            "required": [
              "decision"
            ]
          }
        }
      },
      "inputs": [
        {
          "title": "outputSchema",
          "type": "object"
        },
        {
          "title": "seedUrls",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string"
            }
          }
        },
        {
          "title": "plan",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "title": "userResponse",
          "type": "string"
        }
      ]
    },
    "collect": {
      "component_type": "ApiNode",
      "id": "collect",
      "name": "Collect the candidate members",
      "url": "{{CINATRA_BASE_URL}}/api/llm-bridge",
      "http_method": "POST",
      "data": {
        "agent_id": "list-curator-agent",
        "system": "You are a list-curator collector. Dispatch the child agents per the SKILL.md with agent_list, agent_run and agent_run_get, and read the CRM with crm_account_get. Build the candidate member rows against the APPROVED outputSchema. Do NOT create the list and do NOT add anyone to it - the list is created only after the person approves the members, by a later step. Return a single JSON object with {candidateMembers, dispatchedRuns, failures} - nothing else. dispatchedRuns lists one {runId, agent, status} entry per child run you started, so the person can open each of them.",
        "user": "Collect the members for this curation against the approved schema.\nInputs:\n- intent: {{ intent }}\n- seedUrls: {{ seedUrls }}\n- outputSchema: {{ outputSchema }}\n- targetMemberType: {{ targetMemberType }}",
        "agent_run_id": "{{ agent_run_id }}",
        "cinatra_llm": {
          "preferredProvider": "openai",
          "preferredModel": "gpt-5.5"
        }
      },
      "inputs": [
        {
          "title": "intent",
          "type": "string"
        },
        {
          "title": "seedUrls",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "title": "outputSchema",
          "type": "object"
        },
        {
          "title": "targetMemberType",
          "type": "string"
        },
        {
          "title": "agent_run_id",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "title": "candidateMembers",
          "type": "array",
          "description": "The rows proposed for the list. Intentionally free-form: each row's members are dictated by the outputSchema the person approved for this run, so a fixed member list declared here would not describe the rows the run actually collects.",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "dispatchedRuns",
          "type": "array",
          "description": "One entry per child run this step started, so the person can open each of them.",
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "runId": {
                  "type": "string",
                  "description": "The id of the child agent run."
                },
                "agent": {
                  "type": "string",
                  "description": "The package name of the child agent that was dispatched."
                },
                "status": {
                  "type": "string",
                  "description": "The run status read back from agent_run_get."
                }
              }
            }
          }
        },
        {
          "title": "failures",
          "type": "array",
          "description": "What could not be collected or added, one entry per failed row.",
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "rowIndex": {
                  "type": "integer",
                  "description": "The position of the candidate row this failure belongs to."
                },
                "stage": {
                  "type": "string",
                  "description": "The step that failed, named so the person can tell collection from creation."
                },
                "error": {
                  "type": "string",
                  "description": "What went wrong, in one sentence the person can read."
                },
                "accountId": {
                  "type": "string",
                  "description": "The CRM account this failure hangs off, where the row named one."
                }
              }
            }
          }
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": false,
          "packageName": "@cinatra-ai/list-curator-agent",
          "description": "The collecting half of the retired single step. It dispatches and reads; every CRM write waits behind list_gate."
        }
      }
    },
    "list_gate": {
      "component_type": "InputMessageNode",
      "id": "list_gate",
      "name": "Approve the list",
      "metadata": {
        "cinatra": {
          "riskClass": "approval",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/list-curator-agent:final-list-review",
          "a2uiSurfaceId": "list-curator:final-list-review:input",
          "autoSkipWhenInputsPresent": false,
          "description": "Nothing is written to the CRM before you approve: this is the list that will be created and these are the members that will be added to it.",
          "inputMessageSchema": {
            "type": "object",
            "x-renderer": "@cinatra-ai/list-curator-agent:final-list-review",
            "properties": {
              "candidateMembers": {
                "type": "array",
                "title": "Members",
                "items": {
                  "type": "object"
                },
                "readOnly": true
              },
              "listName": {
                "type": "string",
                "title": "List name"
              },
              "dispatchedRuns": {
                "type": "array",
                "title": "Runs this curation dispatched",
                "items": {
                  "type": "object"
                },
                "readOnly": true
              },
              "failures": {
                "type": "array",
                "title": "What could not be collected",
                "items": {
                  "type": "object"
                },
                "readOnly": true
              },
              "decision": {
                "type": "string",
                "title": "Decision",
                "enum": [
                  "approve",
                  "revise",
                  "reject"
                ],
                "description": "Approve this step, send it back for revision, or reject the run."
              },
              "note": {
                "type": "string",
                "title": "Note"
              }
            },
            "required": [
              "decision"
            ]
          }
        }
      },
      "inputs": [
        {
          "title": "candidateMembers",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "listName",
          "type": "string"
        },
        {
          "title": "dispatchedRuns",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "failures",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        }
      ],
      "outputs": [
        {
          "title": "userResponse",
          "type": "string"
        }
      ]
    },
    "create": {
      "component_type": "ApiNode",
      "id": "create",
      "name": "Create the list and add its members",
      "url": "{{CINATRA_BASE_URL}}/api/llm-bridge",
      "http_method": "POST",
      "data": {
        "agent_id": "list-curator-agent",
        "system": "You are a list-curator writer. The person has APPROVED the members below. Call crm_list_create once for the list, then crm_list_member_add once per approved member. Create nothing else. Return a single JSON object with {listId, memberCount, accountsCreated, contactsCreated, failures, summary} - nothing else.",
        "user": "Create the approved list and add its approved members.\nInputs:\n- listName: {{ listName }}\n- targetMemberType: {{ targetMemberType }}\n- candidateMembers: {{ candidateMembers }}",
        "agent_run_id": "{{ agent_run_id }}",
        "cinatra_llm": {
          "preferredProvider": "openai",
          "preferredModel": "gpt-5.5"
        }
      },
      "inputs": [
        {
          "title": "listName",
          "type": "string"
        },
        {
          "title": "targetMemberType",
          "type": "string"
        },
        {
          "title": "candidateMembers",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "agent_run_id",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "title": "listId",
          "type": "string"
        },
        {
          "title": "memberCount",
          "type": "integer"
        },
        {
          "title": "accountsCreated",
          "type": "integer"
        },
        {
          "title": "contactsCreated",
          "type": "integer"
        },
        {
          "title": "failures",
          "type": "array",
          "description": "What could not be collected or added, one entry per failed row.",
          "json_schema": {
            "items": {
              "type": "object",
              "properties": {
                "rowIndex": {
                  "type": "integer",
                  "description": "The position of the candidate row this failure belongs to."
                },
                "stage": {
                  "type": "string",
                  "description": "The step that failed, named so the person can tell collection from creation."
                },
                "error": {
                  "type": "string",
                  "description": "What went wrong, in one sentence the person can read."
                },
                "accountId": {
                  "type": "string",
                  "description": "The CRM account this failure hangs off, where the row named one."
                }
              }
            }
          }
        },
        {
          "title": "summary",
          "type": "string"
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "write_safe",
          "requiresApproval": false,
          "packageName": "@cinatra-ai/list-curator-agent",
          "description": "The only step that writes: it runs behind the list approval, so the list and its membership exist only once the person said yes."
        }
      }
    },
    "curation_summary": {
      "component_type": "OutputMessageNode",
      "id": "curation_summary",
      "name": "Curation result",
      "inputs": [
        {
          "title": "listId",
          "type": "string"
        },
        {
          "title": "memberCount",
          "type": "integer"
        },
        {
          "title": "failures",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "object"
            }
          }
        },
        {
          "title": "summary",
          "type": "string"
        }
      ],
      "message": "{# pyagentspec-input-hint (do not remove): {{ listId }} {{ memberCount }} {{ failures }} {{ summary }} #}{% if not listId %}The list could not be created, so nothing was saved: {{ summary }}{% elif not memberCount %}The list was created but no members were added to it - nothing came back from the pages that were searched.{% else %}{{ memberCount }} members were added to the list. {{ summary }}{% endif %}{% if failures %} Some entries could not be collected: {{ failures | length }} of them; they are listed with the run.{% endif %}",
      "metadata": {
        "cinatra": {
          "purpose": "plain-language-curation-ending"
        }
      }
    }
  }
