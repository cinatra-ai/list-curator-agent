{
  "agentspec_version": "26.1.0",
  "component_type": "Flow",
  "id": "list-curator-agent-flow",
  "name": "List Curator Agent",
  "description": "Orchestrator agent that curates a CRM list of accounts OR contacts from a natural-language intent. Invokes @cinatra-ai/web-scrape-agent \u2192 @cinatra-ai/company-discovery-agent \u2192 @cinatra-ai/contact-discovery-agent via agent_run, pauses at 2 HITL gates (scrape-schema-review + final-list-review), and materializes the resulting CRM list via crm_list_create + per-member crm_list_member_add after operator approval. NOTE: the 'mixed' member type is not supported \u2014 CRM lists (Twenty Views) are per-object-type.",
  "metadata": {
    "cinatra": {
      "type": "flow",
      "packageName": "@cinatra-ai/list-curator-agent",
      "hitlScreens": [
        "@cinatra-ai/list-curator-agent:scrape-schema-review",
        "@cinatra-ai/list-curator-agent:final-list-review"
      ],
      "llm": {
        "preferredProvider": "openai",
        "preferredModel": "gpt-5.5"
      }
    }
  },
  "inputs": [
    {
      "title": "intent",
      "type": "string"
    },
    {
      "title": "seedUrls",
      "type": "array",
      "json_schema": {
        "items": {
          "type": "string",
          "format": "uri"
        }
      },
      "default": []
    },
    {
      "title": "targetMemberType",
      "type": "string",
      "json_schema": {
        "enum": [
          "contact",
          "account"
        ]
      },
      "default": "contact"
    },
    {
      "title": "listName",
      "type": "string",
      "default": ""
    },
    {
      "title": "cinatra_run_id",
      "type": "string",
      "default": ""
    }
  ],
  "outputs": [
    {
      "title": "listId",
      "type": "string"
    },
    {
      "title": "memberCount",
      "type": "integer"
    },
    {
      "title": "accountsCreated",
      "type": "integer"
    },
    {
      "title": "contactsCreated",
      "type": "integer"
    },
    {
      "title": "failures",
      "type": "array",
      "json_schema": {
        "items": {
          "type": "object"
        }
      }
    },
    {
      "title": "summary",
      "type": "string"
    },
    {
      "title": "dispatchedRuns",
      "type": "array",
      "json_schema": {
        "items": {
          "type": "object"
        }
      }
    }
  ],
