{
  "name": "@cinatra-ai/list-curator-agent",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Orchestrator agent that curates a CRM list of accounts OR contacts from a natural-language intent. Invokes @cinatra-ai/web-scrape-agent → @cinatra-ai/company-discovery-agent → @cinatra-ai/contact-discovery-agent via agent_run, pauses at 2 HITL gates (scrape-schema-review + final-list-review), and materializes the resulting CRM list via crm_list_create + per-member crm_list_member_add after operator approval. The mixed member type is not supported — CRM lists are per-object-type.",
  "type": "module",
  "files": [
    "src",
    "!src/__tests__",
    "cinatra"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.6"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "List Curator Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/web-scrape-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/company-discovery-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "optional",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/contact-discovery-agent",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "optional",
        "kind": "agent"
      },
      {
        "packageName": "@cinatra-ai/list-curation-skill",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required",
        "kind": "skill"
      }
    ],
    "fieldRenderers": [
      {
        "id": "@cinatra-ai/list-curator-agent:scrape-schema-review",
        "kind": "scrape-schema-review",
        "priority": 90,
        "screen": {
          "layout": "card",
          "title": "Review scrape schema",
          "sections": [
            {
              "type": "field",
              "key": "instructions",
              "label": "Instructions",
              "multiline": true,
              "optional": true,
              "placeholder": "Per-row extraction instructions for the scrape child."
            },
            {
              "type": "json",
              "key": "outputSchema",
              "label": "Output schema (JSON Schema)",
              "invalidText": "Invalid JSON"
            },
            {
              "type": "textList",
              "key": "seedUrls",
              "label": "Seed URLs",
              "web": true,
              "placeholder": "https://example.com/path",
              "addLabel": "Add URL",
              "removeLabel": "Remove",
              "removeAriaLabel": "Remove URL",
              "emptyText": "No seed URLs. Add at least one to enable Approve."
            }
          ],
          "decisionsLabel": "Decision",
          "decisions": [
            {
              "label": "Approve",
              "answer": {
                "decision": "approve",
                "approved": true
              },
              "sends": [
                "instructions",
                "outputSchema",
                "seedUrls"
              ]
            },
            {
              "label": "Reject",
              "answer": {
                "decision": "reject",
                "approved": false
              },
              "sends": []
            }
          ],
          "unreadable": {
            "keys": [
              "plan",
              "outputSchema"
            ],
            "text": "The proposal could not be read."
          },
          "answerKey": "userResponse"
        }
      },
      {
        "id": "@cinatra-ai/list-curator-agent:final-list-review",
        "kind": "final-list-review",
        "priority": 90,
        "screen": {
          "layout": "card",
          "title": "Review final list",
          "sections": [
            {
              "type": "field",
              "key": "listName",
              "label": "List name",
              "placeholder": "Final list name"
            },
            {
              "type": "rows",
              "key": "candidateMembers",
              "label": "Members",
              "columns": [
                {
                  "title": "Name",
                  "keys": [
                    "name",
                    "fullName",
                    "displayName",
                    "companyName",
                    "accountName",
                    "contactName",
                    "organizationName",
                    "personName"
                  ],
                  "fallback": "Member",
                  "numbered": true
                }
              ],
              "emptyText": "No members.",
              "missingText": "The members could not be read."
            },
            {
              "type": "rows",
              "key": "failures",
              "label": "Failures",
              "tone": "danger",
              "columns": [
                {
                  "title": "Row",
                  "keys": [
                    "rowIndex"
                  ]
                },
                {
                  "title": "Stage",
                  "keys": [
                    "stage"
                  ]
                },
                {
                  "title": "Error",
                  "keys": [
                    "error"
                  ]
                },
                {
                  "title": "Account",
                  "keys": [
                    "accountId"
                  ]
                }
              ]
            }
          ],
          "decisionsLabel": "Decision",
          "decisions": [
            {
              "label": "Approve list",
              "answer": {
                "decision": "approve",
                "approved": true
              },
              "sends": [
                "listName"
              ],
              "requires": [
                "candidateMembers"
              ]
            },
            {
              "label": "Cancel",
              "answer": {
                "decision": "reject",
                "approved": false
              },
              "sends": []
            }
          ],
          "answerKey": "userResponse"
        }
      }
    ],
    "consumes": [
      {
        "primitive": "agent_list",
        "requirement": "required"
      },
      {
        "primitive": "agent_run",
        "requirement": "required"
      },
      {
        "primitive": "agent_run_get",
        "requirement": "required"
      },
      {
        "primitive": "crm_account_get",
        "requirement": "required"
      },
      {
        "primitive": "crm_list_create",
        "requirement": "required"
      },
      {
        "primitive": "crm_list_member_add",
        "requirement": "required"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "list-curator-agent-flow",
    "sourceVersionId": "5cd6c578-f94c-42e8-80d1-e6e87a6b1ae1",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": true,
    "toolAccess": [],
    "ownerOrgId": null
  }
}
